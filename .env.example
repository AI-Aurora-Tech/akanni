# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://your-project-url.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase public anonymous key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a free API Key at: https://aistudio.google.com/app/apikey
# For AI Studio deployments, it is injected automatically.
VITE_GEMINI_API_KEY="AIzaSy..."
GEMINI_API_KEY="AIzaSy..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FocusNFe Configuration
# Token da API FocusNFe (use o token de HOMOLOGAÇÃO durante os testes)
FOCUS_NFE_TOKEN=
# Ambiente: "sandbox" (homologação, sem validade fiscal) ou "production"
FOCUS_NFE_ENVIRONMENT=sandbox
# (Opcional) Segredo para validar o webhook do FocusNFe
FOCUS_NFE_WEBHOOK_SECRET=
# (Opcional) Preço unitário padrão quando o item não tem valor definido
FOCUS_NFE_PRECO_PADRAO=85

# Dados do emitente (empresa Akanni). OPCIONAIS: se ficarem em branco, o
# FocusNFe usa automaticamente a empresa vinculada ao seu TOKEN (recomendado).
# Só preencha se precisar sobrescrever algum dado específico.
FOCUS_NFE_CNPJ_EMITENTE=
FOCUS_NFE_NOME_EMITENTE=
FOCUS_NFE_LOGRADOURO_EMITENTE=
FOCUS_NFE_NUMERO_EMITENTE=
FOCUS_NFE_BAIRRO_EMITENTE=
FOCUS_NFE_MUNICIPIO_EMITENTE=
FOCUS_NFE_UF_EMITENTE=
FOCUS_NFE_CEP_EMITENTE=
FOCUS_NFE_IE_EMITENTE=
FOCUS_NFE_REGIME_TRIBUTARIO=1

# Webhooks de SAÍDA (nosso sistema -> sistema externo)
# URL que receberá um POST JSON quando o status de um PEDIDO ou de uma NF-e mudar.
# Eventos: "pedido.status_alterado" e "nfe.status_alterado".
# Deixe em branco para desativar o envio.
WEBHOOK_URL=
# (Opcional) Segredo para assinar o corpo (HMAC-SHA256 no header X-Akanni-Signature)
WEBHOOK_OUTBOUND_SECRET=
